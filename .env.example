# Copy to .env and fill in. Never commit .env. Share values in private team chat.
# Sponsor promo codes are in .env.challenges (git-ignored, on Emīls's machine).

# Hugging Face: datasets and checkpoints (private repos)
HF_TOKEN=
HF_NAMESPACE=            # team org or user that owns our private repos

# Verda cloud (sim machine). Credentials come from console.verda.com; nothing needed here by default.
VERDA_SIM_HOST=          # ssh host/IP of the RTX sim machine, e.g. for: ssh -L 55555:localhost:55555 $VERDA_SIM_HOST

# Submission image registry (GHCR or Docker Hub)
REGISTRY_IMAGE=          # e.g. ghcr.io/<owner>/bot-icelli-policy

# LLM/VLM APIs (optional; only for the instruction parser or planner, and it needs an offline fallback)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FEATHERLESS_API_KEY=
NVIDIA_API_KEY=
