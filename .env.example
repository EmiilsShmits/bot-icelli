# Copy to .env and fill in. Never commit .env. Share values in private team chat.
# Sponsor promo codes are in .env.challenges (git-ignored, on Emīls's machine).

# Hugging Face (only if the team decides to store data/weights there)
HF_TOKEN=
HF_NAMESPACE=

# Verda cloud. Personal: each member uses their OWN API credentials from console.verda.com (Keys / API credentials). Don't share these.
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=
VERDA_SIM_HOST=          # ssh host/IP of the RTX sim machine, e.g. for: ssh -L 55555:localhost:55555 $VERDA_SIM_HOST

# Submission image registry (GHCR or Docker Hub)
REGISTRY_IMAGE=          # e.g. ghcr.io/<owner>/bot-icelli-policy

# LLM/VLM APIs (optional; no network is guaranteed at the finals)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FEATHERLESS_API_KEY=
NVIDIA_API_KEY=
